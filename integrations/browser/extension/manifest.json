{
  "manifest_version": 3,
  "name": "ClipRAG \u2014 Clipboard autocomplete",
  "version": "0.3.0",
  "description": "Local suggestions from saved clipboard text, URLs and snippets on websites you enable.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipRAG autocomplete"
  },
  "omnibox": {
    "keyword": "clip"
  },
  "incognito": "not_allowed",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
